{
  "name": "vo-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first stdio MCP server for Verity One. Thin transport adapter over 127.0.0.1:3100. MIT-licensed (same as the repo root LICENSE); `private: true` only means it is not published to npm — it ships in the public source tree and builds locally.",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "vo-mcp": "./bin/vo-mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "serve": "node dist/cli.js serve",
    "doctor": "node dist/cli.js doctor",
    "self-check": "node dist/self-check.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@verity-one/vault-root": "file:../packages/vault-root",
    "smol-toml": "^1.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
