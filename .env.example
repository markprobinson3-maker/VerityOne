# Verity One — Environment Variables
# Copy to .env and fill in values

# PostgreSQL
DATABASE_URL=postgresql://localhost:5432/verity

# Deployment profile (rung F3): "long-lived" (default; local Bun
# server) or "serverless" (Vercel functions + Neon Postgres). The
# long-lived launcher (api/src/index.ts) refuses to boot under
# "serverless"; the Vercel function entrypoint (api/index.ts)
# defaults this to "serverless" before app import.
VERITY_DEPLOYMENT_PROFILE=long-lived

# Default tenant routing (rung F2). Set this to your tenant_id after
# running api/scripts/create-tenant.ts --tenant-id=<id> --set-default.
# When unset, spaces.ts pyramid-default routes fall back to the global
# space. The SQL helpers (verity_default_space_for_*) read the
# canonical default from `graph_state.default_tenant`.
VERITY_DEFAULT_TENANT_ID=

# Bearer token used by miners/src/supercron.ts to call /remember at
# digest time. Same value as one of this tenant's configured agent
# credentials. When unset, supercron skips the /remember POST.
VERITY_SUPERCRON_API_TOKEN=

# Optional repo-root override for shell scripts that need to find the
# repository (defaults to the script's own directory).
# VERITY_REPO_ROOT=

# Existing VO runtime profile (separate axis from
# VERITY_DEPLOYMENT_PROFILE): "tenant-default" or "full".
VERITY_PROFILE=tenant-default

# Strict mode: long-lived/container startup exits if Postgres is
# unreachable. Recommended ON for production container deploys.
# Serverless imports do NOT run the startup probe; routes surface
# DB errors per-request instead of process.exit(1) at cold start.
VERITY_DB_STRICT=on

# API Server
VERITY_API_PORT=3100

# Scope Dev Server
VERITY_SCOPE_PORT=3101

# Embeddings (Google text-embedding-004, 768 dims)
GOOGLE_API_KEY=your-google-api-key

# Mercury (Inception) — for miners
INCEPTION_API_KEY=your-inception-api-key
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1

# Anthropic — for Opus/Sonnet validation
ANTHROPIC_API_KEY=your-anthropic-api-key

# VO+ Hosted Account (optional — only needed for hosted VO+ services)
# Google OAuth for verityone.app account login
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://verityone.app/account/auth/google/callback

# VO+ Tenant Key Management — 64-char hex (32 bytes), required for
# hosted tenant-link approval. Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
