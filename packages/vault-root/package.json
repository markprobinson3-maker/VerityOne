{
  "name": "@verity-one/vault-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dependency-light local vault root resolver and inspector.",
  "scripts": {
    "build:cjs": "bun build src/index.js --target=node --format=cjs --outfile=src/index.cjs"
  },
  "exports": {
    ".": {
      "require": { "types": "./src/index.d.cts", "default": "./src/index.cjs" },
      "import": { "types": "./src/index.d.ts", "default": "./src/index.js" },
      "default": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts"
}
